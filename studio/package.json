{
  "name": "verticalbot-studio",
  "version": "0.1.0",
  "description": "Browser-native robot simulation & offline programming studio (RoboDK / Visual Components class) for industrial, mobile and agricultural robotics",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "server": "npm run build:server && node dist-server/index.js",
    "build:server": "vite build -c vite.server.config.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.186.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/three": "^0.186.0",
    "@types/ws": "*",
    "jsdom": "*",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
